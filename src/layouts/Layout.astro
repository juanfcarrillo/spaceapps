---
import NavBar from "../components/organisms/NavBar.astro";
import Footer from "../components/sections/Footer.astro";

interface Props {
	title: string;
	blank?: boolean;
}
const { title, blank } = Astro.props;
---

<!doctype html>
<html class="h-full scroll-smooth" lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/space_apps_logo_black.png" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content="Aqui hay que poner una descripción de lo que hace Space Apps"
		/>
		<meta
			name="keywords"
			content="Space Apps, Space Apps, Space Apps, Space Apps, Space Apps, Space Apps, Space Apps, Space Apps, Space Apps, Space Apps"
		/>
		<meta name="author" content="Space Apps" />
		<!-- Hotjar Tracking Code for Nasa Space Apps Quito -->
		<script>
			(function(h, o, t, j, a, r) {
				h.hj = h.hj || function() {
				(h.hj.q = h.hj.q || []).push(arguments);
				};
				h._hjSettings = { hjid: 5213522, hjsv: 6 };
				a = o.getElementsByTagName('head')[0];
				r = o.createElement('script');
				r.async = 1;
				r.src = t + h._hjSettings.hjid + j + h._hjSettings.hjsv;
				a.appendChild(r);
			})(window, document, 'https://static.hotjar.com/c/hotjar-', '.js?sv=');
		</script>
	</head>

	<slot name="meta" />

	<meta property="og:title" content={title} />
	<meta property="og:type" content="website" />
	<meta property="og:url" content="https://spaceapps.pages.dev" />
	<meta property="og:image" content="https://spaceapps.pages.dev/3DRocket.png" />


	<title>Space Apps</title>

	<body class="font-sans flex h-full flex-col">
		{!blank && <NavBar transparent />}
		<slot />
		<Footer />
	</body>
</html>

